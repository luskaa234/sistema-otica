VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fica ligado por padrão (mesmo sem este arquivo .env) e pula a checagem
# de login, liberando /admin e /app sem autenticação — útil para navegar
# no painel antes de ter um projeto Supabase configurado. O RLS ainda
# bloqueia os dados reais. Definir como "false" restaura o login normal
# — fazer isso antes de conectar um Supabase real em produção.
VITE_DEV_BYPASS_AUTH=true

# Substitui o Supabase por um cliente demo (dados de exemplo em memória,
# sem nenhuma chamada de rede) — dá pra clicar em tudo e testar o fluxo
# completo sem ter um projeto Supabase configurado. Ativa sozinho sempre
# que VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY não estiverem preenchidos
# (então mesmo sem este .env, ex. deploy novo, o app funciona com dados de
# exemplo em vez de falhar). Definir como "false" desativa mesmo sem
# credenciais reais (não usar assim em produção).
VITE_DEMO_MODE=true
