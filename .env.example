VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only: "true" pula a checagem de login e libera /admin e /app sem
# autenticação, para navegar no painel antes de ter um projeto Supabase
# configurado. O RLS ainda bloqueia os dados reais. NUNCA usar em produção.
VITE_DEV_BYPASS_AUTH=false

# Dev only: "true" substitui o Supabase por um cliente demo (dados de
# exemplo em memória, sem nenhuma chamada de rede) — dá pra clicar em tudo
# e testar o fluxo completo sem ter um projeto Supabase configurado. Usar
# junto com VITE_DEV_BYPASS_AUTH=true para não precisar nem fazer login.
# NUNCA usar em produção.
VITE_DEMO_MODE=false
